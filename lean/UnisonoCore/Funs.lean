  (self : receiver.Receiver N M K) (time : Std.I64) (duration : Std.I64)
  (frames : Std.U32) :
  Result (player.Plan × (receiver.Receiver N M K))
  := do
  if self.following
  then
    let o ← relation.Estimator.impl.line self.clock
    match o with
    | none =>
      ok
        ({
           frames := 0#u32,
           start := { frame := 0#u64, fraction := 0#u64 },
           step := timing.Step.UNITY,
           jumped := false
         }, self)
    | some line =>
      match self.schedule with
      | none =>
        ok
          ({
             frames := 0#u32,
             start := { frame := 0#u64, fraction := 0#u64 },
             step := timing.Step.UNITY,
             jumped := false
           }, self)
      | some schedule =>
        let first ← timing.sender_time line self.path time
        let i ← lift (core.num.I64.saturating_add time duration)
        let last ← timing.sender_time line self.path i
        let o1 ← timing.due schedule first
        match o1 with
        | none =>
          ok
            ({
               frames := 0#u32,
               start := { frame := 0#u64, fraction := 0#u64 },
               step := timing.Step.UNITY,
               jumped := false
             }, self)
        | some now =>
          let (o2, self1) ← receiver.Receiver.reached self now first
          let (schedule1, now1) ←
            match o2 with
            | none => ok (schedule, now)
            | some turned => ok turned
          let o3 ← timing.due schedule1 last
          match o3 with
          | none =>
            ok
              ({
                 frames := 0#u32,
                 start := { frame := 0#u64, fraction := 0#u64 },
                 step := timing.Step.UNITY,
                 jumped := false
               }, self1)
          | some «then» =>
            let (p, p1) ←
              player.Player.cycle self1.player now1 «then» frames duration
                schedule1.level_slope
            ok (p, { self1 with player := p1 })
  else
    ok
      ({
         frames := 0#u32,
         start := { frame := 0#u64, fraction := 0#u64 },
         step := timing.Step.UNITY,
         jumped := false
       }, self)

