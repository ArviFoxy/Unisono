  let level ← sender.Sender.current_level self
  let after ← lift (core.num.U64.saturating_add self.timeline 1#u64)
  if timeline > after
  then
    ok
      {
        self
          with
          timeline,
          next := 0#u64,
          level_index := 0#u64,
          level_base := level,
          stamped := false
      }
  else
    ok
      {
        self
          with
          timeline := after,
          next := 0#u64,
          level_index := 0#u64,
          level_base := level,
          stamped := false
      }

