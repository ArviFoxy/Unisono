/-- [unisono_core::min_rtt::ntp_exchange]:
    Source: 'crates/unisono-core/src/min_rtt.rs', lines 92:0-112:1
    Visibility: public -/
def min_rtt.ntp_exchange
  (ex : min_rtt.Exchange) : Result (Option min_rtt.Sampled) := do
  let i ← lift (IScalar.cast .I128 ex.t4)
  let i1 ← lift (IScalar.cast .I128 ex.t1)
  let leg ← lift (core.num.I128.wrapping_sub i i1)
  let i2 ← lift (IScalar.cast .I128 ex.t3)
  let i3 ← lift (IScalar.cast .I128 ex.t2)
  let proc_t ← lift (core.num.I128.wrapping_sub i2 i3)
  if proc_t < 0#i128
  then ok none
  else
    let rtt ← lift (core.num.I128.wrapping_sub leg proc_t)
    if rtt < 0#i128
    then ok none
    else
      let i4 ← lift (IScalar.cast .I128 ex.t2)
      let i5 ← lift (IScalar.cast .I128 ex.t1)
      let d1 ← lift (core.num.I128.wrapping_sub i4 i5)
      let i6 ← lift (IScalar.cast .I128 ex.t3)
      let i7 ← lift (IScalar.cast .I128 ex.t4)
      let d2 ← lift (core.num.I128.wrapping_sub i6 i7)
      let i8 ← lift (core.num.I128.wrapping_add d1 d2)
      let offset ← fixed.div_floor_wide i8 2#i128
      let i9 ← lift (IScalar.cast .I128 ex.t1)
      let i10 ← fixed.div_floor_wide leg 2#i128
      let midpoint ← lift (core.num.I128.wrapping_add i9 i10)
      let i11 ← fixed.saturate midpoint
      let i12 ← fixed.saturate offset
      let i13 ← fixed.saturate rtt
      ok (some
        { id := ex.id, midpoint_ns := i11, offset_ns := i12, rtt_ns := i13 })

