    let i5 ← fixed.saturating_mul_i128 walk_step1 age
    let i6 ← lift (core.num.I128.wrapping_shr i5 40#u32)
    let walk_ns2 ← fixed.div_floor_wide i6 3#i128
    let i7 ← lift (UScalar.hcast .I128 base_var_ns2)
    let i8 ← lift (core.num.I128.saturating_add i7 white_ns2)
    let i9 ← lift (core.num.I128.saturating_add i8 freq_ns2)
    let total ← lift (core.num.I128.saturating_add i9 walk_ns2)
